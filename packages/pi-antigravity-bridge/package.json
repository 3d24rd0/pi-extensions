{
  "name": "@3d24rd0/pi-antigravity-bridge",
  "version": "1.8.7",
  "description": "Gemini provider for Pi on the Antigravity ACP server (official Google ACP) or the stream-json agy CLI. Use antigravity/* models in Pi. Full /model picker support. Models runs Pi's tools. ToS safe to use.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "antigravity",
    "antigravity-acp",
    "agy",
    "gemini",
    "google",
    "google-acp",
    "acp",
    "agent-client-protocol",
    "mcp",
    "mcp-server",
    "provider",
    "streaming"
  ],
  "license": "MIT",
  "author": {
    "name": "3d24rd0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3d24rd0/pi-extensions.git",
    "directory": "packages/pi-antigravity-bridge"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "extensions",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "@estebanforge/pi-tui-dialogs": "^0.1.2",
    "@modelcontextprotocol/sdk": "^1.31.0"
  }
}
